@inject ApiClient Api
@inject AppState AppState
@implements IDisposable

@if (_loading)
{
    <span class="muted">Loading groups…</span>
}
else if (AppState.Groups.Count == 0)
{
    <span class="muted">No groups yet — <a href="/groups">create or join one</a>.</span>
}
else
{
    <div class="group-bar">
        <label style="margin:0;">Group</label>
        <select value="@AppState.ActiveGroup?.Id" @onchange="OnChange">
            @foreach (var g in AppState.Groups)
            {
                <option value="@g.Id">@g.Name (@g.Role)</option>
            }
        </select>
    </div>
}

@code {
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        if (AppState.Groups.Count == 0)
        {
            var groups = await Api.GetGroupsAsync() ?? new();
            AppState.SetGroups(groups);
        }
        _loading = false;
    }

    private void OnChange(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            AppState.SetActiveGroup(id);
    }

    public void Dispose() => AppState.OnChange -= StateHasChanged;
}
